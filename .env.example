# Copy this file to .env and fill in real values. Never commit .env.

# Core Django
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate-a-long-random-value
# Comma-separated. On Render, the service hostname is added automatically.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origins allowed to call the API (comma-separated, include scheme)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
# Optional: defaults to the https entries in CORS_ALLOWED_ORIGINS
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app

# Database — leave unset locally to use SQLite. Render Postgres injects DATABASE_URL.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_SSL_REQUIRE=True

# Email (Gmail app password). Rotate any password that has been exposed.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=FAT7 3D <you@gmail.com>
EMAIL_TIMEOUT=20
